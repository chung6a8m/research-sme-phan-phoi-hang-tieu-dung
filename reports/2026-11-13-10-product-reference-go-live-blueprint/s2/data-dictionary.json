{
  "schemaVersion": "s2-v2",
  "syntheticOnly": true,
  "basis": "R009 DC-01..18 BR-01..24 and R010-S1 P01/P02; Owner PADR-02/EVQ-05/06, 2026-11-13",
  "conventions": {
    "date": "YYYY-MM-DD local Asia/Ho_Chi_Minh",
    "money": "VND integer strings, exact",
    "quantity": "base UoM Decimal",
    "sourceHash": "SHA256(ascii business columns + tenantCode/schemaVersion/sourceSystem/sourceRecordId/importBatchId, pipe separated)",
    "process": "upload -> validate -> FK/source/balance -> dry-run -> error/discrepancy review -> approval -> commit once",
    "limitation": "All generated examples MODEL_ONLY, no production go-live/e-invoice evidence",
    "requestedModes": "Distinct | delimited tokens A|B_ONLINE|MIXED|B_NO_CHANNEL mapped to S1 requestedModes[]; request does not grant mode admission",
    "openingStockLine": "sourceDocumentId is document header, sourceLineId identifies the opening-stock line",
    "creditPolicy": "T02 UNSET -> no terms/limit/approval, fail-closed; APPROVED -> explicit N>=0 and limit>=0 including approved zero + approvalRef. CSV cannot sign Finance approval.",
    "accounting": "T13 manual register is a candidate type with source IDs, durable posting and reconciliation evidence required.",
    "invoiceScope": "MVP A/B_ONLINE/MIXED B_ONLINE; B alternative channel during PWA outage deferred, B_NO_CHANNEL BLOCKED."
  },
  "commonFields": [
    "tenantCode",
    "schemaVersion",
    "sourceSystem",
    "sourceRecordId",
    "sourceHash",
    "importBatchId"
  ],
  "tables": [
